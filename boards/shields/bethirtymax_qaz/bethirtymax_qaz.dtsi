#include <dt-bindings/zmk/matrix_transform.h>
#include "bethirtymax_qaz-layouts.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        /* J1(20 ピン)の番号 = acdb の D 番号。回路図 QAZ.kicad_sch の J1:
             1 COL9, 2 ROW3, 3 ROW2, 4 ROW1, 5 ROW0, 6 COL8, 7 COL2, 8 COL1,
             9 COL0, 10 COL7, 11 COL6, 12 COL5, 13 COL4, 14 COL3,
             15〜18 空き, 19 GND, 20 Bat+。
           ダイオードはスイッチ側がアノード、ROW 側がカソード(col2row)。 */
        row-gpios = <&akdk_d 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,  /* ROW0 */
            <&akdk_d 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,  /* ROW1 */
            <&akdk_d 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,  /* ROW2 */
            <&akdk_d 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;  /* ROW3 */
        col-gpios = <&akdk_d 9 (GPIO_ACTIVE_HIGH)>,   /* COL0 */
            <&akdk_d 8 (GPIO_ACTIVE_HIGH)>,   /* COL1 */
            <&akdk_d 7 (GPIO_ACTIVE_HIGH)>,   /* COL2 */
            <&akdk_d 14 (GPIO_ACTIVE_HIGH)>,  /* COL3 */
            <&akdk_d 13 (GPIO_ACTIVE_HIGH)>,  /* COL4 */
            <&akdk_d 12 (GPIO_ACTIVE_HIGH)>,  /* COL5 */
            <&akdk_d 11 (GPIO_ACTIVE_HIGH)>,  /* COL6 */
            <&akdk_d 10 (GPIO_ACTIVE_HIGH)>,  /* COL7 */
            <&akdk_d 6 (GPIO_ACTIVE_HIGH)>,   /* COL8 */
            <&akdk_d 1 (GPIO_ACTIVE_HIGH)>;   /* COL9 */
    };

    /* 37 キー。先頭が一番上の小さいキー(EX1 = 3,9)、以下は上の行から。
       COL9 は EX1 のほかは 0 行目(MX36)にしか無く、3 行目は COL4 が空き。 */
    default_transform: keymap_transform {
        compatible = "zmk,matrix-transform";
        rows = <4>;
        columns = <10>;
        map = <
            RC(3,9)
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,5) RC(3,6) RC(3,7) RC(3,8)
        >;
    };
};
